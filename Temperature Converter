import java.util.Scanner;

public class SelfPratice1 {
    public static void main (String [] args) {

        Scanner a = new Scanner (System.in);

        int option = a.nextInt();

        switch (option){
        
            case 1:
                System.out.print("Enter temperature: ");
                double celsius = a.nextDouble();
                double fahrenheit = celsius * 9 / 5 + 32;
                System.out.printf("Result: %.2f", fahrenheit);
                break;

            case 2:
                System.out.print("Enter temperature: ");
                double fahrenheitInput = a.nextDouble();
                double celsiusOutput = (fahrenheitInput - 32) * 5 / 9;
                System.out.printf("Result: %.2f", celsiusOutput);
                break;
            
             default:
                System.out.println("Invalid choice");
            }
    }
}
